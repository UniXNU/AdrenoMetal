+    /// A bounded host wait for completion and all completed handlers.
+    ///
+    /// `Ok(false)` is a timeout and does not cancel, retire or release any work.
+    /// Refused on the same runtime threads as `wait_until_completed`.
+    pub fn wait_until_completed_for(&self, timeout: std::time::Duration) -> Result<bool, Error> {
+        not_in_scheduled_handler()?;
+        if self.on_completion_thread() {
+            return match self.status() {
+                CommandBufferStatus::Completed | CommandBufferStatus::Error => Ok(true),
+                _ => Err(Error::Refused(Refusal::WaitOnOwnThread)),
+            };
+        }
+        self.send();
+        let began = std::time::Instant::now();
+        let mut state = self.state();
+        while !state.finished {
+            let left = timeout.saturating_sub(began.elapsed());
+            if left.is_zero() {
+                return Ok(false);
+            }
+            let (next, _) = self
+                .inner
+                .changed
+                .wait_timeout(state, left)
+                .unwrap_or_else(PoisonError::into_inner);
+            state = next;
+        }
+        Ok(true)
+    }
