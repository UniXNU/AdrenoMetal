+    #[test]
+    fn every_device_bounded_wait_leaves_uncommitted_work_live() {
+        each_device("bounded_wait", |name, _, device| {
+            let queue = queue(&device);
+            let cb = queue.command_buffer().expect("a command buffer");
+            assert!(
+                !cb.wait_until_completed_for(std::time::Duration::ZERO)
+                    .expect("a bounded wait"),
+                "{name}: not committed"
+            );
+            assert_eq!(cb.status(), CommandBufferStatus::NotEnqueued);
+            cb.commit().expect("commit after timeout");
+            assert!(
+                cb.wait_until_completed_for(std::time::Duration::from_secs(30))
+                    .expect("completion wait"),
+                "{name}: completed after commit"
+            );
+            assert!(
+                cb.wait_until_completed_for(std::time::Duration::ZERO)
+                    .expect("completed wait"),
+                "{name}: stays completed"
+            );
+        });
+    }
