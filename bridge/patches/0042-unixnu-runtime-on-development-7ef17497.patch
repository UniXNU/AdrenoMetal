+        Some(at) => at,
+        None if sites.len() < SITE_COUNT => {
+            sites.push(AllocationSite {
+                frames,
+                ..Default::default()
+            });
+            sites.len() - 1
+        }
+        None => sites.len() - 1,
+    };
+    sites[at].bytes += bytes;
+    sites[at].count += 1;
