+const SITE_BYTES: u64 = 4 << 20;
+const SITE_FRAMES: usize = 10;
+const SITE_COUNT: usize = 32;
+static SITES: std::sync::Mutex<Vec<AllocationSite>> = std::sync::Mutex::new(Vec::new());
