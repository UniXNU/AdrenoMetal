+/// [`FinalMakings`] by reference: what a kept pass is looked up by, hashed and compared as the
+/// makings it stands for, so a lookup that finds one copies nothing.
+#[derive(Clone, Copy, PartialEq, Eq, Hash)]
+struct FinalKey<'a> {
+    shape: &'a PassShape,
+    colors: &'a [Ops],
+    depth_stencil: Option<Ops>,
+    resolves: &'a [Ops],
+    depth_stencil_resolve: Option<Ops>,
+    resolving: bool,
+}
+
+impl FinalKey<'_> {
+    fn to_makings(self) -> FinalMakings {
+        FinalMakings {
+            shape: self.shape.clone(),
+            colors: self.colors.to_vec(),
+            depth_stencil: self.depth_stencil,
+            resolves: self.resolves.to_vec(),
+            depth_stencil_resolve: self.depth_stencil_resolve,
+            resolving: self.resolving,
+        }
+    }
+}
+
+/// What has a [`FinalKey`]: the kept makings, and a key looked up by.
+trait FinalKeyed {
+    fn key(&self) -> FinalKey<'_>;
+}
+
+impl FinalKeyed for FinalMakings {
+    fn key(&self) -> FinalKey<'_> {
+        FinalKey {
+            shape: &self.shape,
+            colors: &self.colors,
+            depth_stencil: self.depth_stencil,
+            resolves: &self.resolves,
+            depth_stencil_resolve: self.depth_stencil_resolve,
+            resolving: self.resolving,
+        }
+    }
+}
+
+impl FinalKeyed for FinalKey<'_> {
+    fn key(&self) -> FinalKey<'_> {
+        *self
+    }
+}
+
+impl std::hash::Hash for FinalMakings {
+    fn hash<H: std::hash::Hasher>(&self, state: &mut H) {
+        self.key().hash(state);
+    }
+}
+
+impl std::hash::Hash for dyn FinalKeyed + '_ {
+    fn hash<H: std::hash::Hasher>(&self, state: &mut H) {
+        self.key().hash(state);
+    }
+}
+
+impl PartialEq for dyn FinalKeyed + '_ {
+    fn eq(&self, other: &Self) -> bool {
+        self.key() == other.key()
+    }
+}
+
+impl Eq for dyn FinalKeyed + '_ {}
+
+impl<'a> std::borrow::Borrow<dyn FinalKeyed + 'a> for FinalMakings {
+    fn borrow(&self) -> &(dyn FinalKeyed + 'a) {
+        self
+    }
+}
