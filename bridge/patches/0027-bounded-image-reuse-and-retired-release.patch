+        Stage::MemoryBytes,
+        (bytes >> 10).min(u64::from(u32::MAX)) as u32,
+    );
+    stage_trace::mark(
+        id,
+        Stage::MemoryAvailable,
+        (available >> 10).min(u64::from(u32::MAX)) as u32,
+    );
+    id
