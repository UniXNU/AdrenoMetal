+#[cfg(test)]
+mod reservation_tests {
+    use super::{Grants, IndexClass};
+    #[test]
+    fn reserves_unique_indices_wraps_and_reuses_only_vacated_owners() {
+        let mut grants = Grants::new();
+        let class = IndexClass::Texture;
+        grants.grant(class, 1, 4).unwrap();
+        let mut held = Vec::new();
+        for index in 1..=4 {
+            let (got, owner) = grants.reserve_unused(class).unwrap();
+            assert_eq!(got, index);
+            held.push(owner);
+        }
+        assert!(grants.reserve_unused(class).is_none());
+        assert!(grants.vacate(class, 2, held[1]));
+        assert_eq!(grants.reserve_unused(class).unwrap().0, 2);
+        assert!(grants.reserve_unused(class).is_none());
+    }
+    #[test]
+    fn reservation_drop_cannot_free_the_constructed_resources_index() {
+        let mut grants = Grants::new();
+        let class = IndexClass::Sampler;
+        grants.grant(class, 1, 1).unwrap();
+        let (index, reservation) = grants.reserve_unused(class).unwrap();
+        let resource = grants.place(class, index).unwrap().owner;
+        assert!(!grants.vacate(class, index, reservation));
+        assert!(grants.reserve_unused(class).is_none());
+        assert!(grants.vacate(class, index, resource));
+        assert_eq!(grants.reserve_unused(class).unwrap().0, index);
+    }
+}
