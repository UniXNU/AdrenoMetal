+/// A granted descriptor index reserved before its resource is constructed.
+///
+/// Dropping it returns an unused reservation immediately. After construction placed an
+/// object at the index, that object's retirement owns the index and this drop does nothing.
+pub struct IndexReservation {
+    core: Arc<crate::device::Core>,
+    class: IndexClass,
+    index: u32,
+    owner: Owner,
+}
+
+impl IndexReservation {
+    /// The index passed to a texture, sampler or pipeline constructor.
+    pub fn index(&self) -> u32 {
+        self.index
+    }
+}
+
+impl Drop for IndexReservation {
+    fn drop(&mut self) {
+        lock(&self.core.arrays.grants).vacate(self.class, self.index, self.owner);
+    }
+}
+
+impl Device {
+    /// Reserves an unused index of a grant of `class`, without displacing any live object.
+    ///
+    /// None where every granted index is held. An object's index remains held until
+    /// GPU retirement; a failed constructor leaves only the reservation to drop.
+    pub fn reserve_index(&self, class: IndexClass) -> Option<IndexReservation> {
+        let core = Arc::clone(self.core());
+        let (index, owner) = {
+            let mut grants = lock(&core.arrays.grants);
+            grants.reserve_unused(class)?
+        };
+        Some(IndexReservation {
+            core,
+            class,
+            index,
+            owner,
+        })
+    }
+}
+
