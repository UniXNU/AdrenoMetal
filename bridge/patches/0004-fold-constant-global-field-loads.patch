 /// Erase every defined function's body in place, one at a time, each body replaced freed.
+/// The entry's own blocks that its function constants leave unreachable, and its loads from
+/// fields of constant globals, folded before the entry is inlined, so the inliner copies no callee
+/// only a dead block calls. An uber-shader's entry is most of the module and branches on the
+/// constants into every effect it has: QuartzCore's `fixed_frag` entries inlined 15,700
+/// instructions of which SCCP kept 300, and building, solving and rebuilding the rest was most of a
+/// specialization.
+///
+/// Its calls are opaque here, so what it proves unreachable is unreachable whatever they return,
+/// and the SCCP after inlining reaches the fixed point it reached over the whole body. It runs
+/// only when every declared constant is supplied, so no undefined read goes unrecorded. Any
+/// refusal here (a branch on `undef` that a call's constant result would have made dead) leaves
+/// the entry as it was, for the SCCP after inlining to judge; a budget, cancellation or limit is
+/// final.
+fn prune_entry(
+    parts: &mut ModuleParts,
+    func: FuncId,
+    fcs: &HashMap<GlobalId, sccp::FcState>,
+    name: &DiagName,
+    m: &mut Meter,
+) -> Result<(), Error> {
+    if fcs.is_empty() || fcs.values().any(|s| !s.supplied) {
+        return Ok(());
+    }
+    let Some(entry) = parts.funcs.get_mut(func).and_then(|f| f.body.take()) else {
+        return Ok(());
+    };
+    let pruned = solve(&entry, parts, fcs, name, m).and_then(|solved| {
+        let mut body = solved.body;
+        loop {
+            let (next, folded) = const_loads::fold(body, parts, m)?;
+            if !folded {
+                return Ok(next);
+            }
+            let solved = solve(&next, parts, fcs, name, m);
+            next.release(m);
+            body = solved?.body;
+        }
+    });
+    let kept = match pruned {
+        Ok(body) => {
+            entry.release(m);
+            body
+        }
+        Err(e @ (Error::Budget(_) | Error::Cancelled | Error::LimitExceeded(_))) => return Err(e),
+        Err(_) => entry,
+    };
+    parts
+        .funcs
+        .get_mut(func)
+        .ok_or_else(|| invariant("entry out of range"))?
+        .body = Some(kept);
+    Ok(())
+}
