diff --git a/crates/metal2vulkan-runtime/src/tests/copied.rs b/crates/metal2vulkan-runtime/src/tests/copied.rs
index 99c72c0..7816c9d 100644
--- a/crates/metal2vulkan-runtime/src/tests/copied.rs
+++ b/crates/metal2vulkan-runtime/src/tests/copied.rs
@@ -1472,3 +1472,73 @@ fn a_copy_in_with_no_base_splits_across_threads_and_answers_as_one_thread_does()
     );
     drop(copied);
 }
+
+/// On macOS a commit compares no copy whose pages the process cannot read now, and a completion
+/// merges into none it cannot write: Core Animation's render server frees memory under no-copy
+/// buffers that still live in its caches, and a commit that may reach every copy would read the
+/// freed pages (a fault in the render server's commit). Such a copy keeps its bytes and takes no
+/// base, and is compared again once its pages are mapped. The pages here lose their protection
+/// rather than their mapping, so that nothing else of the process is mapped where they were.
+#[cfg(target_os = "macos")]
+#[test]
+fn a_commit_leaves_a_copy_alone_while_its_pages_cannot_be_read() {
+    // SAFETY: the system's page size.
+    let page = unsafe { libc::sysconf(libc::_SC_PAGESIZE) } as usize;
+    let length = 4 * page;
+    // SAFETY: an anonymous mapping of the test's own, of `length` bytes.
+    let mapped = unsafe {
+        libc::mmap(
+            std::ptr::null_mut(),
+            length,
+            libc::PROT_READ | libc::PROT_WRITE,
+            libc::MAP_PRIVATE | libc::MAP_ANON,
+            -1,
+            0,
+        )
+    };
+    assert_ne!(mapped, libc::MAP_FAILED, "mapped");
+    let pages = NonNull::new(mapped.cast::<u8>()).unwrap();
+    // SAFETY: the mapping's bytes.
+    unsafe { std::ptr::write_bytes(pages.as_ptr(), 7, length) };
+    let buffers = Arc::new(CopiedBuffers::default());
+    let counts = Counters::default();
+    let all = CopiesReached::all();
+    let mut copy = vec![0_u8; length];
+    // SAFETY: the copy and the pages are the test's, of `length` bytes, live past the answer.
+    let copied = unsafe { add_reading(&buffers, pages, at(&mut copy), length, plain, false) };
+    let copied = copied.unwrap();
+    // SAFETY: a byte of the mapping.
+    unsafe { pages.as_ptr().add(100).write(0xAA) };
+    commit_reading(&buffers, &counts);
+    assert_eq!(copy[100], 0xAA, "copied in while the pages are mapped");
+    // The CPU writes a page that stays readable; the last two pages can no longer be read.
+    // SAFETY: a byte of the mapping, then the protection of its last two pages.
+    let protected = unsafe {
+        pages.as_ptr().add(200).write(0xBB);
+        libc::mprotect(mapped.byte_add(2 * page), 2 * page, libc::PROT_NONE)
+    };
+    assert_eq!(protected, 0, "protected");
+    commit_reading(&buffers, &counts);
+    assert_eq!(copy[200], 7, "not compared: no byte of the pages was read");
+    // A command buffer that may write every copy gives this one no base, and its completion
+    // merges nothing into pages it cannot write.
+    commit_writing(&buffers, &counts);
+    assert_eq!(counts.copied_tallies().bases_made, 0, "no base");
+    copy[300] = 0xCC;
+    buffers.merge_back(&counts, &all);
+    // Readable again: the next commit takes the write made meanwhile.
+    // SAFETY: the protection of the mapping's last two pages.
+    let restored = unsafe {
+        libc::mprotect(
+            mapped.byte_add(2 * page),
+            2 * page,
+            libc::PROT_READ | libc::PROT_WRITE,
+        )
+    };
+    assert_eq!(restored, 0, "readable again");
+    commit_reading(&buffers, &counts);
+    assert_eq!(copy[200], 0xBB, "compared again");
+    drop(copied);
+    // SAFETY: the test's mapping, which nothing reads any more.
+    unsafe { libc::munmap(mapped, length) };
+}
