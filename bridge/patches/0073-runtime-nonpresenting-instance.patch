--- a/crates/metal2vulkan-runtime/src/tests/floor.rs
+++ b/crates/metal2vulkan-runtime/src/tests/floor.rs
@@ -2308,3 +2308,30 @@ fn a_device_that_does_not_calibrate_the_host_clock_is_below_the_floor() {
