+/// On `PROFILES` and in `runtime-floor`'s window, both render (fragment) and compute (kernel)
+/// stages return at entry where their floor tail holds what the consumer never pushes, with no
+/// per-field selects over pushed fields (`EmitCx::emit_tail_guard`).
+#[test]
+fn the_floor_s_tail_returns_at_entry_without_per_field_selects() {
+    for (fragment, expected_pushed) in [(true, 3usize), (false, 4usize)] {
+        for stem in PROFILES.iter().copied().chain(["runtime-floor"]) {
+            let Some((pushed, selects, branches, returns)) = tail_test_uses(stem, fragment, 3) else {
+                return;
+            };
+            assert_eq!(pushed, expected_pushed, "{stem} fragment={fragment}");
+            assert_eq!(selects, 0, "{stem} fragment={fragment}: a select on the tail");
+            assert_eq!(branches, 1, "{stem} fragment={fragment}: the branch on the tail");
+            assert_eq!(returns, 2, "{stem} fragment={fragment}: the module's returns");
+        }
     }
