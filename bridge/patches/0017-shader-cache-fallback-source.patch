+
+/// A read-only source of entries behind every cache directory: given an entry's path relative to its directory's root, its bytes,
+/// or false. A process whose entries were made ahead (on another machine, for the same driver and runtime) reads them from there
+/// without copying them into the directory; what it makes itself still goes to the directory. Set once, before any device opens.
+pub type Fallback = fn(&str, &mut Vec<u8>) -> bool;
+static FALLBACK: std::sync::OnceLock<Fallback> = std::sync::OnceLock::new();
+
+/// Set the read-only source behind every cache directory ([`Fallback`]); false where one was set already.
+pub fn set_fallback(source: Fallback) -> bool {
+    FALLBACK.set(source).is_ok()
+}
+
+/// The fallback's bytes of the entry at `path` under `root`.
+fn fallback_read(root: &Path, path: &Path) -> Option<Vec<u8>> {
+    let source = FALLBACK.get()?;
+    let relative = path.strip_prefix(root).ok()?.to_str()?;
+    let mut bytes = Vec::new();
+    source(relative, &mut bytes).then_some(bytes)
+}
