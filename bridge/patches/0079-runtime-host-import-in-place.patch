+/// Aspect mask for `vkGetImageSubresourceLayout` on an in-place linear image: single-plane DRM
+/// modifier images require `MEMORY_PLANE_0_EXT` (`VUID-vkGetImageSubresourceLayout-image-02270`).
+pub(crate) fn in_place_subresource_aspect(explicit_modifier: bool) -> vk::ImageAspectFlags {
+    if explicit_modifier {
+        vk::ImageAspectFlags::MEMORY_PLANE_0_EXT
+    } else {
+        vk::ImageAspectFlags::COLOR
+    }
+}
