+/// `DRM_FORMAT_MOD_LINEAR`.
+const MOD_LINEAR: u64 = 0;
+
+/// Computes the `VkImageUsageFlags` for a linear in-place image over a buffer.
+///
+/// Preserves `SAMPLED | ATTACHMENT_FEEDBACK_LOOP_EXT` when `feedback` is true and `plan_usage`
+/// carries `ATTACHMENT_FEEDBACK_LOOP_EXT`; otherwise strips `ATTACHMENT_FEEDBACK_LOOP_EXT` (and
+/// `SAMPLED` when shaders do not read the texture directly). Adds `COLOR_ATTACHMENT` when
+/// `linear_resolves` is set.
+pub(crate) fn linear_image_usage(
+    plan_usage: vk::ImageUsageFlags,
+    read: bool,
+    linear_resolves: bool,
+    feedback: bool,
+) -> vk::ImageUsageFlags {
+    let mut usage = if feedback
+        && plan_usage.contains(vk::ImageUsageFlags::ATTACHMENT_FEEDBACK_LOOP_EXT)
+    {
+        plan_usage
+    } else {
+        let mut usage = plan_usage & !vk::ImageUsageFlags::ATTACHMENT_FEEDBACK_LOOP_EXT;
+        if !read {
+            usage &= !vk::ImageUsageFlags::SAMPLED;
+        }
+        usage
+    };
+    if linear_resolves {
+        usage |= vk::ImageUsageFlags::COLOR_ATTACHMENT;
+    }
+    usage
+}
+
+/// Whether an image supports in-pass attachment reads (`[[color(n)]]` fetch and same-pass
+/// sampling): enabled whenever the plan asks for attachment reads and either the image carries
+/// `ATTACHMENT_FEEDBACK_LOOP_EXT` (`looped`) or a shadow image was configured (`has_shadow`).
+pub(crate) fn in_place_attachment_reads(
+    plan_reads: bool,
+    looped: bool,
+    has_shadow: bool,
+) -> bool {
+    plan_reads && (looped || has_shadow)
+}
+
+/// Source stage and access mask for an unzeroed image's move home: an in-place image over a
+/// buffer starting from `UNDEFINED` (a host-memory import, whose external handle bars
+/// `PREINITIALIZED` under `VUID-VkImageCreateInfo-pNext-01443`) makes prior host writes visible
+/// to all commands; any other unzeroed homing starts from `NONE`.
+pub(crate) fn homing_host_dependency(
+    first: vk::ImageLayout,
+    over_buffer: bool,
+) -> (vk::PipelineStageFlags2, vk::AccessFlags2) {
+    match first {
+        vk::ImageLayout::UNDEFINED if over_buffer => (
+            vk::PipelineStageFlags2::HOST,
+            vk::AccessFlags2::HOST_WRITE,
+        ),
+        _ => (vk::PipelineStageFlags2::NONE, vk::AccessFlags2::NONE),
+    }
+}
+
+/// Whether copies keep an image in its home (`GENERAL`) layout instead of transitioning to
+/// `TRANSFER_{SRC,DST}_OPTIMAL`: images starting `PREINITIALIZED`, in-place buffer aliases
+/// (including host-memory imports starting `UNDEFINED`), and exported surface planes.
+pub(crate) fn keeps_home_on_copy(
+    first: vk::ImageLayout,
+    over_buffer: bool,
+    surface: bool,
+) -> bool {
+    first == vk::ImageLayout::PREINITIALIZED || over_buffer || surface
+}
+
+/// Selects the in-place layout for a host-memory import from the explicit `DRM_FORMAT_MOD_LINEAR`
+/// probe (`modifier`: `Some((extent_ok, features_ok, feedback))` when
+/// `VK_EXT_image_drm_format_modifier` is enabled) and the plain `LINEAR` probe
+/// (`linear`: `(extent_ok, features_ok, feedback)`).
+/// Selects the in-place layout and whether to drop extended storage view usage for a host-memory
+/// import, probing explicit `DRM_FORMAT_MOD_LINEAR` (extended, then unextended) ahead of plain
+/// `LINEAR` (extended, then unextended) so driver-accepted row pitches bind directly before
+/// falling back to strict plain linear pitch limits.
+pub(crate) fn select_host_plan(
+    memory_type: u32,
+    modifier: Option<(bool, bool, bool)>,
+    plain_modifier: Option<(bool, bool, bool)>,
+    linear: (bool, bool, bool),
+    plain_linear: Option<(bool, bool, bool)>,
+) -> (Result<Laid, OverCause>, bool) {
+    if let Some((true, true, feedback)) = modifier {
+        (
+            Ok(Laid::HostMemory {
+                memory_type,
+                explicit_modifier: true,
+                feedback,
+            }),
+            false,
+        )
+    } else if let Some((true, true, feedback)) = plain_modifier {
+        (
+            Ok(Laid::HostMemory {
+                memory_type,
+                explicit_modifier: true,
+                feedback,
+            }),
+            true,
+        )
+    } else if let (true, true, feedback) = linear {
+        (
+            Ok(Laid::HostMemory {
+                memory_type,
+                explicit_modifier: false,
+                feedback,
+            }),
+            false,
+        )
+    } else if let Some((true, true, feedback)) = plain_linear {
+        (
+            Ok(Laid::HostMemory {
+                memory_type,
+                explicit_modifier: false,
+                feedback,
+            }),
+            true,
+        )
+    } else if modifier.is_some_and(|(extent, _, _)| extent)
+        || plain_modifier.is_some_and(|(extent, _, _)| extent)
+        || linear.0
+        || plain_linear.is_some_and(|(extent, _, _)| extent)
+    {
+        (Err(OverCause::LinearFeatures), false)
+    } else {
+        (Err(OverCause::HostMemory), false)
+    }
+}
