diff --git a/crates/metal2vulkan-runtime/src/tests/texture.rs b/crates/metal2vulkan-runtime/src/tests/texture.rs
index 3da5b978..88a9a943 100644
--- a/crates/metal2vulkan-runtime/src/tests/texture.rs
