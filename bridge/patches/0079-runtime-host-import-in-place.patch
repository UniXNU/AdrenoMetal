+/// The format features of `format` under single-plane `DRM_FORMAT_MOD_LINEAR`
+/// (`VK_EXT_image_drm_format_modifier`), or empty where no single-plane linear modifier is listed.
+fn drm_linear_features(core: &Core, format: vk::Format) -> vk::FormatFeatureFlags2 {
+    let mut list = vk::DrmFormatModifierPropertiesList2EXT::default();
+    let mut properties = vk::FormatProperties2::default().push_next(&mut list);
+    // SAFETY: `core.physical` is `core.instance`'s, which is Vulkan 1.3, and the caller gates this
+    // on `core.exports.modifiers`.
+    unsafe {
+        (core.instance.vk()).get_physical_device_format_properties2(
+            core.physical,
+            format,
+            &mut properties,
+        )
+    };
+    let count = list.drm_format_modifier_count as usize;
+    if count == 0 {
+        return vk::FormatFeatureFlags2::empty();
+    }
+    let mut entries = vec![vk::DrmFormatModifierProperties2EXT::default(); count];
+    let mut list = vk::DrmFormatModifierPropertiesList2EXT::default()
+        .drm_format_modifier_properties(&mut entries);
+    let mut properties = vk::FormatProperties2::default().push_next(&mut list);
+    // SAFETY: as above; `entries` holds the count the device answered.
+    unsafe {
+        (core.instance.vk()).get_physical_device_format_properties2(
+            core.physical,
+            format,
+            &mut properties,
+        )
+    };
+    let written = (list.drm_format_modifier_count as usize).min(entries.len());
+    entries[..written]
+        .iter()
+        .find(|entry| {
+            entry.drm_format_modifier == MOD_LINEAR && entry.drm_format_modifier_plane_count == 1
+        })
+        .map_or(vk::FormatFeatureFlags2::empty(), |entry| {
+            entry.drm_format_modifier_tiling_features
+        })
+}
+
+/// Whether single-plane `DRM_FORMAT_MOD_LINEAR` holds every feature `plan`'s optimal image uses,
+/// for both `plan.format` and any mutable view formats in `plan.view_formats`.
+fn drm_linear_plan_features(core: &Core, plan: &Plan) -> bool {
+    let kept = kept_features(plan.usage);
+    let check = |format: vk::Format| {
+        let (_, optimal) = core.format_features(format);
+        drm_linear_features(core, format).contains(optimal & kept)
+    };
+    check(plan.format)
+        && (plan.view_formats.iter().copied())
+            .filter(|&vf| vf != plan.format)
+            .all(check)
+}
