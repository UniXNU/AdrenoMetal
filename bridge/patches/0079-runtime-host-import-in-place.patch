+/// `DRM_FORMAT_MOD_LINEAR`.
+const MOD_LINEAR: u64 = 0;
+
+/// Source stage and access mask for an unzeroed image's move home: an in-place image over a
+/// buffer starting from `UNDEFINED` (a host-memory import, whose external handle bars
+/// `PREINITIALIZED` under `VUID-VkImageCreateInfo-pNext-01443`) makes prior host writes visible
+/// to all commands; any other unzeroed homing starts from `NONE`.
+pub(crate) fn homing_host_dependency(
+    first: vk::ImageLayout,
+    over_buffer: bool,
+) -> (vk::PipelineStageFlags2, vk::AccessFlags2) {
+    match first {
+        vk::ImageLayout::UNDEFINED if over_buffer => (
+            vk::PipelineStageFlags2::HOST,
+            vk::AccessFlags2::HOST_WRITE,
+        ),
+        _ => (vk::PipelineStageFlags2::NONE, vk::AccessFlags2::NONE),
+    }
+}
+
+/// Whether copies keep an image in its home (`GENERAL`) layout instead of transitioning to
+/// `TRANSFER_{SRC,DST}_OPTIMAL`: images starting `PREINITIALIZED`, in-place buffer aliases
+/// (including host-memory imports starting `UNDEFINED`), and exported surface planes.
+pub(crate) fn keeps_home_on_copy(
+    first: vk::ImageLayout,
+    over_buffer: bool,
+    surface: bool,
+) -> bool {
+    first == vk::ImageLayout::PREINITIALIZED || over_buffer || surface
+}
+
+/// Selects the in-place layout for a host-memory import from the explicit `DRM_FORMAT_MOD_LINEAR`
+/// check (`modifier_ok`: `Some((extent_ok, features_ok))` when `VK_EXT_image_drm_format_modifier`
+/// is enabled) and the plain `LINEAR` check (`linear_ok`: `(extent_ok, features_ok)`).
+pub(crate) fn select_host_laid(
+    memory_type: u32,
+    modifier_ok: Option<(bool, bool)>,
+    linear_ok: (bool, bool),
+) -> Result<Laid, OverCause> {
+    if modifier_ok == Some((true, true)) {
+        Ok(Laid::HostMemory {
+            memory_type,
+            explicit_modifier: true,
+        })
+    } else if linear_ok == (true, true) {
+        Ok(Laid::HostMemory {
+            memory_type,
+            explicit_modifier: false,
+        })
+    } else if modifier_ok.is_some_and(|(extent, _)| extent) || linear_ok.0 {
+        Err(OverCause::LinearFeatures)
+    } else {
+        Err(OverCause::HostMemory)
+    }
+}
+
+/// Whether `bytes_per_row` fits an explicit DRM modifier plane layout without 32-bit truncation.
+pub(crate) fn in_place_pitch_fits(bytes_per_row: u64, explicit_modifier: bool) -> bool {
+    !explicit_modifier || u32::try_from(bytes_per_row).is_ok()
+}
+
+/// Maps a `vkCreateImage` error on an in-place explicit-modifier image to a fallback copy cause.
+pub(crate) fn in_place_create_error(
+    result: vk::Result,
+    explicit_modifier: bool,
+) -> Option<OverCause> {
+    (explicit_modifier && result == vk::Result::ERROR_INVALID_DRM_FORMAT_MODIFIER_PLANE_LAYOUT_EXT)
+        .then_some(OverCause::Pitch)
+}
