+#[cfg(test)]
+mod consumer_cache_tests {
+    use super::{CacheLookup, Caches};
+    use crate::counters::Counters;
+    use std::sync::{Arc, Mutex};
+
+    struct Layer {
+        bytes: Vec<u8>,
+        verdicts: Mutex<Vec<bool>>,
+    }
+    impl CacheLookup for Layer {
+        fn read(&self, _name: &str) -> Option<Vec<u8>> {
+            Some(self.bytes.clone())
+        }
+        fn verdict(&self, _name: &str, accepted: bool, _bytes: u64) {
+            self.verdicts.lock().unwrap().push(accepted);
+        }
+    }
+    #[test]
+    fn readonly_entries_go_through_the_callers_decoder() {
+        let layer = Arc::new(Layer {
+            bytes: b"whole lowering".to_vec(),
+            verdicts: Mutex::default(),
+        });
+        let mut caches = Caches::new(None, 1024, &Counters::new());
+        caches.lookup = Some(layer.clone());
+        let decoded =
+            caches.translation(&[1; 32], |bytes| (bytes == b"whole lowering").then_some(7));
+        assert_eq!(decoded, Some(7));
+        let rejected = caches.translation(&[1; 32], |_bytes| None::<u32>);
+        assert_eq!(rejected, None);
+        assert_eq!(*layer.verdicts.lock().unwrap(), vec![true, false]);
+    }
+}
