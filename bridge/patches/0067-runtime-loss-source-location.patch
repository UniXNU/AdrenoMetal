+/// Source location where a failing Vulkan operation was observed.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct LossLocation {
+    /// Runtime or consumer source file.
+    pub file: &'static str,
+    /// One-based line number.
+    pub line: u32,
+    /// One-based column number.
+    pub column: u32,
+}
+
+impl LossLocation {
+    /// Captures the caller without collecting or allocating a stack trace.
+    #[track_caller]
+    pub fn caller() -> Self {
+        let at = std::panic::Location::caller();
+        Self {
+            file: at.file(),
+            line: at.line(),
+            column: at.column(),
+        }
+    }
+}
+
