+    pub source: Option<LossLocation>,
     /// What it returned.
     pub result: vk::Result,
     /// The device's fault report (`vkGetDeviceFaultInfoEXT`), which the runtime reads once, at
@@ -139,9 +165,12 @@ pub struct DeviceLoss {
 
 impl DeviceLoss {
     /// The loss a failed Vulkan `call` names, for `map_err`.
+    #[track_caller]
     pub(crate) fn of(call: &'static str) -> impl FnOnce(vk::Result) -> DeviceLoss {
+        let source = Some(LossLocation::caller());
         move |result| DeviceLoss {
             call,
+            source,
             result,
             fault: None,
         }
@@ -1759,3 +1788,22 @@ impl Drop for CbInner {
         }
     }
 }
+
+#[cfg(test)]
+mod loss_location_tests {
+    use super::DeviceLoss;
+    use ash::vk;
+
+    #[test]
+    fn the_failure_mapper_keeps_its_creation_site() {
+        let line = line!() + 1;
+        let failure = DeviceLoss::of("vkQueueSubmit2");
+        let loss = failure(vk::Result::ERROR_DEVICE_LOST);
+        let at = loss.source.expect("failure source");
+        assert_eq!(at.file, file!());
+        assert_eq!(at.line, line);
+        assert_eq!(loss.call, "vkQueueSubmit2");
+        assert_eq!(loss.result, vk::Result::ERROR_DEVICE_LOST);
+        assert_eq!(loss.clone().source, Some(at));
+    }
+}
